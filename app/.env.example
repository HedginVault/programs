# devnet | testnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Server-only RPC used for every read, simulation, build and transaction send (never shipped to the browser)
RPC_URL=
# Optional: override the program id baked into src/idl/hedge_vault.json
NEXT_PUBLIC_PROGRAM_ID=
# Optional: Jupiter API (defaults to lite-api.jup.ag without a key, api.jup.ag with one)
JUPITER_API_HOST=
JUPITER_API_KEY=
# Optional: Meteora DLMM pool search API (defaults to dlmm.datapi.meteora.ag)
METEORA_DLMM_API_HOST=
