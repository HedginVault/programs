# devnet | testnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Server-only RPC used for every read, simulation and build (never shipped to the browser)
RPC_URL=
# Optional: endpoint the browser sends signed transactions to (defaults to the public endpoint)
NEXT_PUBLIC_RPC_URL=
# Optional: override the program id baked into src/idl/hedge_vault.json
NEXT_PUBLIC_PROGRAM_ID=
# Optional: Jupiter API (defaults to lite-api.jup.ag without a key, api.jup.ag with one)
JUPITER_API_HOST=
JUPITER_API_KEY=
