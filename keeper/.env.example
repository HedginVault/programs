# RPC used for every read, simulation and send
RPC_URL=
# JSON array of 64 u8 numbers: the nav_updater secret key (same bytes as a Solana keypair file)
KEEPER_KEYPAIR=
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hedge_keeper
# Loop period in seconds
TICK_INTERVAL_SECS=60
# Seconds after an epoch boundary before the keeper posts, absorbs chain clock lag
EPOCH_POST_OFFSET_SECS=300
# Alert when the updater's SOL balance falls below this
MIN_SOL_BALANCE=0.05
# Post even while the protocol status is Paused
POST_WHILE_PAUSED=false
# Simulate and record only, never send
DRY_RUN=false
# Optional JSON POST target for alerts
ALERT_WEBHOOK_URL=
# Also send successful posts to the webhook
ALERT_INFO=false
# Optional Jupiter API (defaults to lite-api.jup.ag without a key, api.jup.ag with one)
JUPITER_API_HOST=
JUPITER_API_KEY=
# Optional program id override for devnet
PROGRAM_ID=
