# RPC used for every read, simulation and send
RPC_URL=
# JSON array of 64 u8 numbers: the nav_updater secret key (same bytes as a Solana keypair file)
KEEPER_KEYPAIR=
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hedge_keeper
# hedge_vault program id
PROGRAM_ID=r2ahBQ6gbPCJ9FxBymYcXuwXi8NmenRry7SE7QR7FAt
# Jupiter API key (api.jup.ag), used for token prices
JUPITER_API_KEY=
# true: simulate and record only, never send. Start here, flip to false once the breakdowns look right.
DRY_RUN=true
# Optional JSON POST target for warn/error alerts
ALERT_WEBHOOK_URL=
